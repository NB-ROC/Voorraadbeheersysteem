<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:login="clr-namespace:FrontendAdmin.ViewModels.Login"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FrontendAdmin.Views.Login.LoginPageView"
             x:DataType="{x:Type login:LoginPageViewModel}">
    
<Grid Background="#F3F4F6">

    <!-- Card -->
    <Border Width="500"
            Height="450"
            Background="#D9D9D9"
            CornerRadius="25"
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

        <StackPanel>

            <!-- Title (LEFT aligned like design) -->
            <TextBlock Text="Login"
                       FontSize="32"
                       Margin="0,0,0,30"
                       Foreground="#2E2E5E"/>

            <!-- Form container -->
            <StackPanel Spacing="25" Margin="0,40,0,0">

                <!-- Username -->
                <Border CornerRadius="25"
                        BorderBrush="#6C6CB3"
                        BorderThickness="1"
                        Height="45"
                        Width="280"
                        HorizontalAlignment="Center">
                    
                    <TextBox Background="Transparent"
                             BorderThickness="0"
                             Padding="10"
                             Text="{Binding Username}"/>
                </Border>

                <!-- Password -->
                <Border CornerRadius="25"
                        BorderBrush="#6C6CB3"
                        BorderThickness="1"
                        Height="45"
                        Width="280"
                        HorizontalAlignment="Center">
                    
                    <TextBox Background="Transparent"
                             BorderThickness="0"
                             Padding="10"
                             Text="{Binding Password}"/>
                </Border>

                <!-- Button + text row -->
                <StackPanel Orientation="Horizontal"
                            Margin="40,40,0,0"
                            VerticalAlignment="Center"
                            Spacing="20">

                    <!-- Purple pill button -->
                    <Button Width="120"
                            Height="35"
                            Background="#6C6CB3"
                            CornerRadius="20"
                            Command="{Binding LoginCommand}"/>

                    <!-- Text next to button -->
                    <TextBlock Text="Aanmelden"
                               VerticalAlignment="Center"
                               Foreground="#6B5E5E"/>
                </StackPanel>

            </StackPanel>

        </StackPanel>

    </Border>

</Grid>
</UserControl>
