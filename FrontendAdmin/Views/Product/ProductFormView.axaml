<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FrontendAdmin.Models"
             xmlns:product="clr-namespace:FrontendAdmin.ViewModels.Product"
             x:DataType="{x:Type product:ProductFormViewModel}"
             x:Class="FrontendAdmin.Views.Product.ProductFormView">

    <Grid ColumnDefinitions="*,*" RowDefinitions="*">

        <!-- LEFT -->
        <StackPanel Grid.Column="0"
                    Margin="20"
                    Spacing="10">

            <StackPanel>
                <TextBlock Text="Naam:" />
                <TextBox Text="{Binding Name}"
                         MaxLength="{x:Static models:ProductModel.NameLength}" />
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Categorie:" />

                <!-- Existing categories -->
                <ComboBox ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding CategoryModel}">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>

                <!-- Optional custom category -->
                <TextBlock Text="Of nieuwe categorie:" />

                <TextBox Text="{Binding CustomCategory}"
                         Watermark="Nieuwe categorie..." />
            </StackPanel>
            <StackPanel Spacing="5">
                <TextBlock Text="Rol:" />

                <ComboBox ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding RoleModel}">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Beschrijving:" />
                <TextBox Text="{Binding Description}"
                         MinLines="5"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         MaxLength="{x:Static models:ProductModel.DescriptionLength}" />
            </StackPanel>

            <Button Content="Opslaan"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0" />

            <TextBlock Text="{Binding Error}"
                       Foreground="Red"
                       TextWrapping="Wrap" />

        </StackPanel>

        <!-- RIGHT -->
        <StackPanel Grid.Column="1"
                    Margin="20"
                    Spacing="10">

            <Button Content="Selecteer afbeelding"
                    Command="{Binding GetImageCommand}" />

            <Border Width="400"
                    Height="400"
                    BorderBrush="Black"
                    BorderThickness="1">

                <Image Source="{Binding PreviewImage}"
                       Stretch="Uniform" />

            </Border>

        </StackPanel>

    </Grid>
</UserControl>