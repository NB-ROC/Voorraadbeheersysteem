<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FrontendAdmin.Models"
             xmlns:product="clr-namespace:FrontendAdmin.ViewModels.Product"
             x:DataType="{x:Type product:ProductFormViewModel}"
             x:Class="FrontendAdmin.Views.Product.ProductFormView">

    <Grid ColumnDefinitions="*,*" RowDefinitions="*">
        
        <StackPanel Grid.Column="0" Margin="20">
            
            <StackPanel>
                <TextBlock Foreground="Black" Text="Naam:" />
                <TextBox MaxLength="{x:Static models:ProductModel.NameLength}"
                         Text="{Binding Name}" Margin="0,0,0,10" />
            </StackPanel>

            <StackPanel>
                <TextBlock Foreground="Black" Text="Categorie ID:" />
                <TextBox Text="{Binding CategoryId}" Margin="0,0,0,10" />
            </StackPanel>

            <StackPanel>
                <TextBlock Foreground="Black" Text="Beschrijving:" />
                <TextBox MinLines="3"
                         TextWrapping="Wrap"
                         MaxLength="{x:Static models:ProductModel.DescriptionLength}"
                         Text="{Binding Description}"
                         Margin="0,0,0,10" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center">
                <Button Content="Opslaan" Command="{Binding SaveCommand}" />
                <TextBlock Foreground="Red" Text="{Binding Error}" />
            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Column="1" Margin="20" Spacing="10">
            
            <Button Content="Selecteer afbeelding"
                    Command="{Binding GetImageCommand}"
                    Margin="0 0 0 10" />

            <Border Height="400" Width="400" BorderThickness="1" BorderBrush="Black">
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
            </Border>

        </StackPanel>
    </Grid>
</UserControl>