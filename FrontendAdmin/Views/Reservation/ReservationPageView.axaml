<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:reservation="clr-namespace:FrontendAdmin.ViewModels.Reservation"
             x:Class="FrontendAdmin.Views.Reservation.ReservationPageView"
             x:DataType="{x:Type reservation:ReservationPageViewModel}">

    <Grid RowDefinitions="60,*,60">

        <ContentControl Content="{Binding Header}" />

        <DockPanel Grid.Row="1" Background="White">

            <!-- Bottom buttons -->
            <Grid DockPanel.Dock="Bottom" Margin="15,10,15,15" ColumnDefinitions="*,10,*">

                <Button Grid.Column="0"
                        Content="Annuleer"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Height="40"
                        Background="#6a69ad"
                        Foreground="White"
                        CornerRadius="4"
                        HorizontalContentAlignment="Center"
                        Click="OnAnnuleerClick" />

                <Button Grid.Column="2"
                        Content="Bevestig"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        Background="#6a69ad"
                        Foreground="White"
                        CornerRadius="4"
                        HorizontalContentAlignment="Center"
                        Click="OnBevestigClick" />
            </Grid>

            <!-- Main content -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15" Margin="30">

                <!-- Image placeholder -->
                <Border Width="180" Height="150"
                        BorderBrush="#cccccc"
                        BorderThickness="1"
                        Background="#eeeeee"
                        HorizontalAlignment="Center">
                    <TextBlock Text="🖼" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" />
                </Border>

                <!-- Item name -->
                <TextBlock Text="Item Naam"
                           Foreground="#aaaaaa"
                           FontSize="18"
                           HorizontalAlignment="Center" />

                <!-- Divider -->
                <Border Height="1" Background="#aaaaaa" HorizontalAlignment="Stretch" />

                <!-- Date -->
                <TextBlock Text="Datum: 12-15 Juni"
                           Foreground="#aaaaaa"
                           FontSize="14"
                           HorizontalAlignment="Center" />

            </StackPanel>

        </DockPanel>

        <ContentControl Grid.Row="2" Content="{Binding Footer}" />

    </Grid>


</UserControl>