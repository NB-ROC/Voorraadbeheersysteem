<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FrontendAdmin.ViewModels.Notifications"
             x:Class="FrontendAdmin.Views.Notifications.NotificationDetailView"
             x:DataType="vm:NotificationDetailViewModel">

    <Grid RowDefinitions="60,*,60">

        <ContentControl Content="{Binding Header}" />

        <StackPanel Grid.Row="1"
                    Margin="20"
                    Spacing="16">

            <!-- Terug knop -->
            <Button Content="← Terug"
                    Width="100"
                    HorizontalAlignment="Left"
                    Background="{StaticResource DarkerWhite}"
                    CornerRadius="8"
                    Padding="12,8"
                    Command="{Binding BackCommand}" />

            <TextBlock Text="{Binding Title}"
                       FontSize="28"
                       FontWeight="Bold"/>

            <Border Background="{StaticResource White}"
                    Padding="16"
                    CornerRadius="12"
                    BorderBrush="{StaticResource DarkerWhite}"
                    BorderThickness="1">

                <StackPanel Spacing="12">

                    <TextBlock Text="{Binding Description}"
                               FontSize="14"
                               Foreground="{StaticResource Gray}"
                               TextWrapping="Wrap" />
                </StackPanel>

            </Border>

        </StackPanel>

        <ContentControl Grid.Row="2" Content="{Binding Footer}" />

    </Grid>

</UserControl>