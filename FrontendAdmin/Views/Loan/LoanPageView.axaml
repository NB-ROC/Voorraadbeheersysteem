<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loan="clr-namespace:FrontendAdmin.ViewModels.Loan"
             x:Class="FrontendAdmin.Views.Loan.LoanPageView"
             x:DataType="{x:Type loan:LoanPageViewModel}">

    <Grid RowDefinitions="60,*,60">

        <ContentControl Content="{Binding Header}" />

        <DockPanel Grid.Row="1" Background="{StaticResource White}" Margin="10">
            <!-- titel -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Mijn Leningen"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10" />
            <!-- Zoekbalken -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Border BoxShadow="{StaticResource Shadow}">
                    <TextBox Width="250"
                             Watermark="🔍 Zoek op product of datum"
                             Text="{Binding ProductQuery, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,10,0" />
                </Border>
                <Border BoxShadow="{StaticResource Shadow}">
                    <TextBox Width="250" Watermark="🔍 Zoek op gebruiker"
                             Text="{Binding BorrowerQuery, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                
            </StackPanel>

            <!-- filters -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                <Button Content="Actief"
                        Command="{Binding FilterStatusCommand}"
                        CommandParameter="Active"
                        Background="{StaticResource Purple}"
                        Foreground="{StaticResource White}" />

                <Button Content="Te laat"
                        Command="{Binding FilterStatusCommand}"
                        CommandParameter="Overdue"
                        Background="{StaticResource Purple}"
                        Foreground="{StaticResource White}" />

                <Button Content="Ingeleverd"
                        Command="{Binding FilterStatusCommand}"
                        CommandParameter="Returned"
                        Background="{StaticResource Purple}"
                        Foreground="{StaticResource White}" />

                <Button Content="Reset"
                        Command="{Binding ResetCommand}"
                        Background="{StaticResource Purple}"
                        Foreground="{StaticResource White}" />
            </StackPanel>
            <!-- Leningen -->
            <ScrollViewer>
                <ItemsControl x:Name="LoanList" ItemsSource="{Binding FilteredLoans}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="loan:LoanViewModel" >
                            <Border BorderBrush="{StaticResource Purple}" BorderThickness="0,0,0,1" Padding="10">
                                <Grid ColumnDefinitions="80,*,100,Auto">
                                    <Image Source="{Binding Image}" Width="70" Height="70" Grid.Column="0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="14" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource Gray}">
                                            <Run Text="Lener:" />
                                            <Run Text="{Binding BorrowerNumber}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="{StaticResource Gray}">
                                            <Run Text="Leen datum:" />
                                            <Run Text="{Binding LoanDate}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ReturnDate}" Grid.Column="2"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource Gray}" />
                                    <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="5"
                                            Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource White}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <ContentControl Grid.Row="2" Content="{Binding Footer}" />


    </Grid>


</UserControl>