<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FrontendAdmin.ViewModels"
        x:Class="FrontendAdmin.Views.MainWindow"
        Width="800"
        Height="450"
        Background="#F5F5F7"
        Title="FrontendAdmin"
        x:DataType="vm:MainWindowViewModel">

    <DockPanel>
        <!-- Header -->
        <Border Background="#6a69ad" Height="60" DockPanel.Dock="Top">
            <Grid>
                <TextBlock Text="Welkom [Naam gebruiker]"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Padding="20,0,0,0"
                           Foreground="White"
                           FontSize="18" />
            </Grid>
        </Border>

        <!-- Bottom Navigation Bar -->
        <Border Background="#3b3b5c" Height="60" DockPanel.Dock="Bottom">
            <UniformGrid Rows="1" Columns="4">
                <Button Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding NavigateToDashboard}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="⊞" Foreground="White" HorizontalAlignment="Center" FontSize="16" />
                        <TextBlock Text="Dashboard" Foreground="White" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding NavigateToProducts}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="☰" Foreground="White" HorizontalAlignment="Center" FontSize="16" />
                        <TextBlock Text="Producten" Foreground="White" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding NavigateToLoans}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="📋" Foreground="White" HorizontalAlignment="Center" FontSize="16" />
                        <TextBlock Text="Leningen" Foreground="White" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding NavigateToProfile}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="👤" Foreground="White" HorizontalAlignment="Center" FontSize="16" />
                        <TextBlock Text="Profiel" Foreground="White" HorizontalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
        
        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>

</Window>