<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="clr-namespace:FrontendAdmin.ViewModels.Dashboard"
             
             x:Class="FrontendAdmin.Views.Dashboard.DashboardPageView"
             x:DataType="{x:Type dashboard:DashboardPageViewModel}">

    <Grid RowDefinitions="60,*,60">

        <ContentControl Content="{Binding Header}" />

        <DockPanel Background="#FAFAFA" Grid.Row="1">
            <Border Height="250" DockPanel.Dock="Top" Padding="15">
                <UniformGrid Rows="1" Columns="4" HorizontalAlignment="Stretch">
                    <Border Background="#FAFAFA" Margin="0,0,16,0" BorderBrush="#6E6EB4"
                            BorderThickness="3" CornerRadius="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="0" Foreground="#6E6EB4" HorizontalAlignment="Center" FontSize="70"
                                       FontWeight="Bold" />
                            <TextBlock Text="Actieve Leningen" Foreground="#6E6EB4" HorizontalAlignment="Center"
                                       FontSize="22" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F5F5FA" Margin="0,0,16,0" BorderBrush="Orange"
                            BorderThickness="3" CornerRadius="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="0" Foreground="orange" HorizontalAlignment="Center" FontSize="70"
                                       FontWeight="Bold" />
                            <TextBlock Text="Bijna te laat" Foreground="orange" HorizontalAlignment="Center"
                                       FontSize="22" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F5F5FA" Margin="0,0,16,0" BorderBrush="red"
                            BorderThickness="3" CornerRadius="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="0" Foreground="red" HorizontalAlignment="Center" FontSize="70"
                                       FontWeight="Bold" />
                            <TextBlock Text="Te laat" Foreground="red" HorizontalAlignment="Center" FontSize="22" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F5F5FA" Margin="0,0,16,0" BorderBrush="Green"
                            BorderThickness="3" CornerRadius="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="0" Foreground="Green" HorizontalAlignment="Center" FontSize="70"
                                       FontWeight="Bold" />
                            <TextBlock Text="Beschikbare Products" Foreground="Green" HorizontalAlignment="Center"
                                       FontSize="22" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Border>
            <Border DockPanel.Dock="Top" Padding="10,0,10,10">
                <StackPanel Spacing="20">
                    <Button HorizontalAlignment="Stretch" Height="70" BorderBrush="#6E6EB4" BorderThickness="3" CornerRadius="12"
                            Background="#F5F5FA">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#EDEDF7">
                                <TextBlock Text="☰" Foreground="#6E6EB4" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="producten overzicht" Foreground="#6E6EB4"
                                           FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Bekijk en beheer alle beschikbare producten" Foreground="#888"
                                           FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button HorizontalAlignment="Stretch" Height="70" BorderBrush="#6E6EB4" BorderThickness="3" CornerRadius="12"
                            Background="#F5F5FA">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#EDEDF7">
                                <TextBlock Text="📋" Foreground="#6E6EB4" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Leningen overzicht" Foreground="#6E6EB4"
                                           FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Bekijk al je leningen" Foreground="#888"
                                           FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="70" BorderBrush="#6E6EB4" BorderThickness="3" CornerRadius="12"
                            Background="#F5F5FA">
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#EDEDF7">
                                <TextBlock Text="👤" Foreground="#6E6EB4" FontSize="22"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Gebruikers overzicht" Foreground="#6E6EB4"
                                           FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Bekijk en beheer alle gebruikers" Foreground="#888"
                                           FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </DockPanel>

        <ContentControl Grid.Row="2" Content="{Binding Footer}" />
    </Grid>

</UserControl>