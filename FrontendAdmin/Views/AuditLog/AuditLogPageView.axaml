<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FrontendAdmin.ViewModels.AuditLog"
             x:Class="FrontendAdmin.Views.AuditLog.AuditLogPageView"
             x:DataType="vm:AuditLogPageViewModel">

    <Grid RowDefinitions="60,*,60">

        <!-- HEADER -->
        <ContentControl Content="{Binding Header}" />

        <!-- MAIN -->
        <Grid Grid.Row="1"
              Background="#F6F7FB"
              RowDefinitions="Auto,Auto,Auto,*">

            <!-- TITLE -->
            <StackPanel Grid.Row="0"
                        Margin="20,20,20,12"
                        Spacing="4">

                <TextBlock Text="Audit Log"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1F2937" />

                <TextBlock Text="Alle staat-veranderende acties van beheerders en uitleners"
                           FontSize="13"
                           Foreground="#6B7280" />
            </StackPanel>

            <!-- SEARCH -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="20,0,20,10"
                        Spacing="10">

                <Border BoxShadow="0 4 10 #33000000">
                    <TextBox Width="450"
                             Watermark="🔍 Zoek op product, datum, actie..."
                             Text="{Binding AuditLogQuery, UpdateSourceTrigger=PropertyChanged}" />
                </Border>

                <Border BoxShadow="0 4 10 #33000000">
                    <TextBox Width="350"
                             Watermark="🔍 Zoek op admin..."
                             Text="{Binding AdminQuery, UpdateSourceTrigger=PropertyChanged}" />
                </Border>

            </StackPanel>

            <!-- FILTER BUTTONS (FIXED) -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="20,0,20,10">

                <Button Content="All"
                        Command="{Binding FilterStatusCommand}"
                        CommandParameter=""
                        Padding="12,6"
                        CornerRadius="8"
                        Background="#E5E7EB"
                        Foreground="#374151"
                        BorderThickness="0"/>

                <Button Content="CREATE"
                        Command="{Binding FilterStatusCommand}"
                        CommandParameter="CREATE"
                        Padding="12,6"
                        CornerRadius="8"
                        Background="#E5E7EB"
                        Foreground="#374151"
                        BorderThickness="0"/>

                <Button Content="UPDATE"
                        Command="{Binding FilterStatusCommand}"
                        CommandParameter="UPDATE"
                        Padding="12,6"
                        CornerRadius="8"
                        Background="#E5E7EB"
                        Foreground="#374151"
                        BorderThickness="0"/>

                <Button Content="DELETE"
                        Command="{Binding FilterStatusCommand}"
                        CommandParameter="DELETE"
                        Padding="12,6"
                        CornerRadius="8"
                        Background="#E5E7EB"
                        Foreground="#374151"
                        BorderThickness="0"/>

                <Button Content="LOGIN"
                        Command="{Binding FilterStatusCommand}"
                        CommandParameter="LOGIN"
                        Padding="12,6"
                        CornerRadius="8"
                        Background="#E5E7EB"
                        Foreground="#374151"
                        BorderThickness="0"/>

            </StackPanel>

            <!-- LIST -->
            <ScrollViewer Grid.Row="3"
                          Margin="20,0,20,20">

                <ItemsControl ItemsSource="{Binding FilteredLogs}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">

                            <Border Margin="0,0,0,10"
                                    Background="White"
                                    CornerRadius="12"
                                    Padding="16"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1">

                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="14">

                                    <!-- ACTION BADGE -->
                                    <Border Grid.Column="0"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            Background="{Binding ActionColor}"
                                            VerticalAlignment="Center"
                                            MinWidth="72">

                                        <TextBlock Text="{Binding Action}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <!-- CONTENT -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="3">

                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="#111827" />

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="13"
                                                   Foreground="#374151"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="12"
                                                   Foreground="#9CA3AF" />

                                    </StackPanel>

                                    <!-- TIME -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Timestamp}"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

        <!-- FOOTER -->
        <ContentControl Grid.Row="2"
                        Content="{Binding Footer}" />

    </Grid>

</UserControl>