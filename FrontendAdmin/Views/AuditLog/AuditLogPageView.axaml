<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FrontendAdmin.ViewModels.AuditLog"
             x:Class="FrontendAdmin.Views.AuditLog.AuditLogPageView"
             x:DataType="vm:AuditLogPageViewModel">

    <Grid RowDefinitions="60,*,60">

        <ContentControl Content="{Binding Header}" />

        <Grid Grid.Row="1" Background="#F6F7FB" RowDefinitions="Auto,*">

            <StackPanel Grid.Row="0" Margin="20,20,20,12" Spacing="4">
                <TextBlock Text="Audit Log"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1F2937" />
                <TextBlock Text="Alle staat-veranderende acties van beheerders en uitleners"
                           FontSize="13"
                           Foreground="#6B7280" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
                <ItemsControl ItemsSource="{Binding Logs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">

                            <Border Margin="0,0,0,10"
                                    Background="White"
                                    CornerRadius="12"
                                    Padding="16"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1">

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                    <Border Grid.Column="0"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            Background="{Binding ActionColor}"
                                            VerticalAlignment="Center"
                                            MinWidth="72"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Action}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="3">

                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="#111827" />

                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="13"
                                                   Foreground="#374151"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="12"
                                                   Foreground="#9CA3AF" />

                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Timestamp}"
                                               FontSize="12"
                                               Foreground="#6B7280"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>

        <ContentControl Grid.Row="2" Content="{Binding Footer}" />

    </Grid>

</UserControl>
