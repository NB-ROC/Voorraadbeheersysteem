<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FrontendAdmin.Views.ProfielView">

    <DockPanel Background="White">
        <TextBlock DockPanel.Dock="Top"
                   Text="Profiel"
                   FontSize="20"
                   Foreground="#aaaaaa"
                   Margin="15,15,15,10" />

        <TextBlock DockPanel.Dock="Top"
                   Text="..."
                   Foreground="#888888"
                   FontSize="14"
                   Margin="15,0,15,0" />
    </DockPanel>

</UserControl>