<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FrontendAdmin.Views.Pages.LoanPageView">

    <DockPanel Background="White">
        <!-- Title -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Mijn Leningen"
                   Foreground="#aaaaaa"
                   FontSize="20"
                   Margin="15,15,15,10" />

        <!-- Products list -->
        <ScrollViewer DockPanel.Dock="Top">
            <StackPanel>

                <!-- Lening 1 - Op tijd -->
                <Border BorderBrush="#eeeeee" BorderThickness="0,0,0,1" Padding="15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="60" Height="60"
                                BorderBrush="#cccccc"
                                BorderThickness="1"
                                Background="#eeeeee">
                            <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="10,0,10,0">
                            <TextBlock Text="Mcdonalds" FontWeight="Bold" FontSize="14" Foreground="#aaaaaa"/>
                            <TextBlock Text="👤 Uitgeleend door: 123123412" FontSize="12" Foreground="#aaaaaa"/>
                            <TextBlock Text="📅 Uitgeleend op: 10-03-2026" Foreground="#aaaaaa" FontSize="12"/>
                            <TextBlock Text="⏰ Terug voor: 25-03-2026" Foreground="#aaaaaa" FontSize="12"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="#e6f4ea"
                                CornerRadius="4"
                                Padding="10,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="Actief" Foreground="#2e7d32" FontSize="12" FontWeight="Bold" />
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</UserControl>