<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:FrontendAdmin.Views.Pages"
             x:Class="FrontendAdmin.Views.Pages.LoanPageView">

    <DockPanel Background="White" Margin="10">
        <!-- titel -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Mijn Leningen"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Zoekbalken -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox"
                     Width="250"
                     Watermark="Zoek op product of datum"
                     KeyUp="SearchBox_KeyUp"
                     Margin="0,0,10,0"/>
            <TextBox x:Name="GebruikerSearchBox"
                     Width="250"
                     Watermark="Zoek op gebruiker"
                     KeyUp="SearchBox_KeyUp"/>
        </StackPanel>

        <!-- filters -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button Content="Actief" Click="FilterButton_Click" Background="#2e7d32" Foreground="White"/>
            <Button Content="Te laat" Click="FilterButton_Click" Background="#d32f2f" Foreground="White"/>
            <Button Content="Ingeleverd" Click="FilterButton_Click" Background="#0277bd" Foreground="White"/>
            <Button Content="Reset" Click="ResetButton_Click" Background="#777777" Foreground="White"/>
        </StackPanel>

        <!-- Leningen -->
        <ScrollViewer>
            <ItemsControl x:Name="LeningLijst">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pages:LeningItem">
                        <Border BorderBrush="#eeeeee" BorderThickness="0,0,0,1" Padding="10">
                            <Grid ColumnDefinitions="80,*,100,Auto" RowDefinitions="Auto">
                                <!-- afbeelding -->
                                <Image Source="{Binding Image}" Width="70" Height="70" Grid.Column="0"/>
                                <!-- lener/uitleendatum tekst -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding ProductNaam}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock FontSize="12" Foreground="#555">
                                        <Run Text="Lener:"/>
                                        <Run Text="{Binding LenerNummer}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#555">
                                        <Run Text="Uitleendatum:"/>
                                        <Run Text="{Binding UitleendDatum}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- terug datum tekst -->
                                <TextBlock Text="{Binding TerugDatum}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="#555"/>

                                <!-- Status tekst -->
                                <Border Background="{Binding StatusKleur}" CornerRadius="4" Padding="5" Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="White"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>