<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FrontendAdmin.Views.Pages.ProductPage">

    <Grid Background="#F6F7FB" RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,12" Spacing="4">
            <TextBlock Text="Items Overzicht"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>
            <TextBlock Text="Bekijk en beheer alle beschikbare items"
                       FontSize="13"
                       Foreground="#6B7280"/>
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Margin="20,0,20,16"
                Background="White"
                CornerRadius="12"
                Padding="14"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="10">

                <!-- Zoekbalk -->
                <Border Grid.Column="0"
                        Background="#F9FAFB"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <TextBlock Text="🔍 Zoek producten of items..."
                               Foreground="#9CA3AF"
                               FontSize="13" />
                </Border>

                <!-- Filter knop -->
                <Button Grid.Column="1"
                        Content="Filters"
                        Height="38"
                        MinWidth="100"
                        Background="#F3F4F6"
                        Foreground="#111827"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="8"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />

                <!-- Product toevoegen -->
                <Button Grid.Column="2"
                        Content="Product toevoegen"
                        Height="38"
                        MinWidth="150"
                        Background="#4F46E5"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="8"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="OnAddProductClick"/>
            </Grid>
        </Border>

        <!-- Items lijst -->
        <ScrollViewer Grid.Row="2" Margin="20,0,20,20">
            <StackPanel Spacing="12">

                <Border Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <Grid ColumnDefinitions="80,*,Auto"
                          ColumnSpacing="14">

                        <!-- Thumbnail -->
                        <Border Grid.Column="0"
                                Width="72"
                                Height="72"
                                Background="#F3F4F6"
                                BorderBrush="#D1D5DB"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TextBlock Text="?"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="22"
                                       Foreground="#9CA3AF"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <TextBlock Text="Categorie / Type"
                                       Foreground="#9CA3AF"
                                       FontSize="12"/>
                            <TextBlock Text="Item Naam"
                                       Foreground="#111827"
                                       FontWeight="Bold"
                                       FontSize="16"/>
                            <TextBlock Text="Korte beschrijving van het item of extra metadata"
                                       Foreground="#6B7280"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Actie -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center">
                            <Button Content="Reserveer"
                                    Background="#4F46E5"
                                    Foreground="White"
                                    BorderThickness="0"
                                    CornerRadius="8"
                                    Padding="14,8"
                                    MinWidth="100"
                                    Click="OnReserveerClick"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>