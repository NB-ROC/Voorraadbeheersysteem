<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:user="clr-namespace:FrontendAdmin.ViewModels.User"
             x:Class="FrontendAdmin.Views.User.UserPageView"
             x:DataType="user:UserPageViewModel"
             xmlns:service="using:FrontendAdmin.Services">

    <Grid Background="#F6F7FB" RowDefinitions="Auto,Auto,*">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,12" Spacing="4">
            <TextBlock Text="Gebruiker Overzicht"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1F2937" />
            <TextBlock Text="Bekijk en beheer alle gebruikers"
                       FontSize="13"
                       Foreground="#6B7280" />
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Margin="20,0,20,16"
                Background="White"
                CornerRadius="12"
                Padding="14"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="10">

                <!-- Zoekbalk -->
                <Border Grid.Column="0"
                        Background="#F9FAFB"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <TextBlock Text="🔍 Zoek gebruikers..."
                               Foreground="#9CA3AF"
                               FontSize="13" />
                </Border>

                <!-- Filter knop -->
                <Button Grid.Column="1"
                        Content="Filters"
                        Height="38"
                        MinWidth="100"
                        Background="#F3F4F6"
                        Foreground="#111827"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        CornerRadius="8"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center" />

                <!-- Product toevoegen -->
                <Button Grid.Column="2"
                        Content="Gebruiker toevoegen"
                        Height="38"
                        MinWidth="150"
                        Background="#4F46E5"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="8"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding Navigation.NavigateCommand}"
                        CommandParameter="{x:Static service:Page.UserForm}" />
            </Grid>
        </Border>

        <!-- Items lijst -->
        <ScrollViewer Grid.Row="2" Margin="20,0,20,20">
            <ListBox ItemsSource="{Binding Users}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type user:UserViewModel}">
                        <StackPanel Spacing="12">

                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14">
                                <Grid ColumnDefinitions="80,*,Auto"
                                      ColumnSpacing="14">

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="4">
                                        <TextBlock Text="{Binding Number}"
                                                   Foreground="#9CA3AF"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#111827"
                                                   FontWeight="Bold"
                                                   FontSize="16" />
                                        <TextBlock Text="{Binding Email}"
                                                   Foreground="#6B7280"
                                                   FontSize="13"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Actie -->
                                    <DockPanel HorizontalSpacing="12" Grid.Column="2"
                                               VerticalAlignment="Center">
                                        <Button Content="Bewerk"
                                                Background="Orange"
                                                Foreground="White"
                                                Padding="12 8"
                                                CornerRadius="8"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Command="{Binding EditCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Verwijder"
                                                Background="Red"
                                                Foreground="White"
                                                Padding="12 8"
                                                CornerRadius="8"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Command="{Binding DeleteCommand}" />
                                    </DockPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

    </Grid>
</UserControl>