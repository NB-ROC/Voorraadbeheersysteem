<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FrontendAdmin.App"
             xmlns:local="clr-namespace:FrontendAdmin"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    
    <Application.Resources>
        <SolidColorBrush x:Key="Purple">#6E6EB4</SolidColorBrush>
        <SolidColorBrush x:Key="White">#FAFAFA</SolidColorBrush>
        <SolidColorBrush x:Key="DarkerWhite">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Gray">#6B7280</SolidColorBrush>
        <BoxShadows x:Key="Shadow">0 4 10 0 #40000000</BoxShadows>
        <SolidColorBrush x:Key="Correct">Green</SolidColorBrush>
        <SolidColorBrush x:Key="Warning">orange</SolidColorBrush>
        <SolidColorBrush x:Key="Danger">Red</SolidColorBrush>
    </Application.Resources>
</Application>