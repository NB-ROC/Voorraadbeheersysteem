<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="using:Frontend.ViewModels.CustomerProduct"
             xmlns:product="clr-namespace:Frontend.ViewModels.Product"
             x:Class="Frontend.Views.CustomerProduct.CustomerProductPageView"
             x:DataType="cp:CustomerProductPageViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <StackPanel Margin="20,20,20,12" Spacing="4">
            <TextBlock Text="Shop"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1F2937" />

            <TextBlock Text="Bekijk alle producten"
                       FontSize="13"
                       Foreground="#6B7280" />
        </StackPanel>

        <!-- PRODUCT LIST -->
        <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
        
            <ListBox ItemsSource="{Binding Products}">
        
                <ListBox.ItemTemplate>
        
                    <DataTemplate DataType="{x:Type product:ProductViewModel}">
        
                        <Border Background="White"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,0,12">
        
                            <Grid ColumnDefinitions="80,*,Auto"
                                  ColumnSpacing="14">
        
                                <!-- IMAGE -->
                                <Border Width="72"
                                        Height="72"
                                        Background="#F3F4F6"
                                        CornerRadius="10">
        
                                    <Panel>
                                        <!-- Loading -->
                                        <TextBlock Text="⏳"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="22"
                                                   Foreground="#9CA3AF"
                                                   IsVisible="{Binding IsImageLoading}" />
        
                                        <!-- Loaded -->
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding !IsImageLoading}" />
        
                                        <!-- Failed -->
                                        <TextBlock Text="⚠️"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="22"
                                                   IsVisible="{Binding ImageFailed}" />
                                    </Panel>
                                </Border>
        
                                <!-- INFO -->
                                <StackPanel Grid.Column="1"
                                            Spacing="4"
                                            VerticalAlignment="Center">
        
                                    <TextBlock Text="{Binding CategoryName}"
                                               FontSize="12"
                                               Foreground="#9CA3AF"/>
        
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="Bold"/>
        
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="13"
                                               Foreground="#6B7280"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
        
                                <!-- ACTIONS -->
                                <StackPanel Grid.Column="2"
                                            Spacing="8"
                                            VerticalAlignment="Center">
        
                                    <Button Content="Toevoegen aan mandje"
                                            Background="Orange"
                                            Foreground="White"
                                            Padding="12,6"
                                            CornerRadius="8"
                                            />
        
                                    <Button Content="Verwijderen"
                                            Background="Red"
                                            Foreground="White"
                                            Padding="12,6"
                                            CornerRadius="8"
                                            />
        
                                </StackPanel>
        
                            </Grid>
        
                        </Border>
        
                    </DataTemplate>
        
                </ListBox.ItemTemplate>
        
            </ListBox>
        
        </ScrollViewer>

    </Grid>

</UserControl>