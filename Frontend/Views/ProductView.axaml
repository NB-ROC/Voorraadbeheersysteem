<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Frontend.ViewModels"
    x:Class="Frontend.Views.ProductView"
    x:DataType="vm:ProductViewModel"
    Background="#1e1e2f">

	<Grid Margin="20" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*">

		<DataGrid Grid.Row="0"
                  ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  Height="250"
                  Margin="0,0,0,15"
                  Background="#2a2a3e"
                  BorderBrush="#44475a"
                  BorderThickness="1"
                  Foreground="White"
                  GridLinesVisibility="Horizontal">
			<DataGrid.Columns>
				<DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
				<DataGridTextColumn Header="Naam" Binding="{Binding Name}" Width="*"/>
				<DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="*"/>
				<DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
			</DataGrid.Columns>
		</DataGrid>

		<Grid Grid.Row="1" Margin="0,0,0,15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<TextBlock Text="Naam:" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="0" Grid.Column="0" Foreground="White" FontWeight="Bold"/>
			<TextBox Watermark="Naam"
                     Text="{Binding SelectedProduct.Name}"
                     Grid.Row="0" Grid.Column="1" Margin="0,0,10,5"
                     Background="#2a2a3e" BorderBrush="#44475a" BorderThickness="1" Padding="5" CornerRadius="5" Foreground="White"/>

			<TextBlock Text="Categorie:" VerticalAlignment="Center" Margin="0,0,5,5" Grid.Row="0" Grid.Column="2" Foreground="White" FontWeight="Bold"/>
			<TextBox Watermark="Categorie"
                     Text="{Binding SelectedProduct.Category}"
                     Grid.Row="0" Grid.Column="3" Margin="0,0,0,5"
                     Background="#2a2a3e" BorderBrush="#44475a" BorderThickness="1" Padding="5" CornerRadius="5" Foreground="White"/>

			<TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,5,0" Grid.Row="1" Grid.Column="0" Foreground="White" FontWeight="Bold"/>
			<ComboBox SelectedItem="{Binding SelectedProduct.Status}" Grid.Row="1" Grid.Column="1"
                      Background="#2a2a3e" BorderBrush="#44475a" BorderThickness="1" Padding="5" CornerRadius="5" Foreground="White">
				<ComboBoxItem>Available</ComboBoxItem>
				<ComboBoxItem>Borrowed</ComboBoxItem>
				<ComboBoxItem>Defective</ComboBoxItem>
			</ComboBox>
		</Grid>

		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="10">
			<Button Content="Opslaan" Command="{Binding SaveCommand}" Width="100"
                    Background="#6a9eff" Foreground="White" BorderThickness="0" CornerRadius="5" Padding="5,2"/>
			<Button Content="Verwijderen" Command="{Binding DeleteCommand}" Width="100"
                    Background="#ff6a6a" Foreground="White" BorderThickness="0" CornerRadius="5" Padding="5,2"/>
			<Button Content="Vorige" Command="{Binding PrevPageCommand}" Width="100"
                    Background="#8c6aff" Foreground="White" BorderThickness="0" CornerRadius="5" Padding="5,2"/>
			<Button Content="Volgende" Command="{Binding NextPageCommand}" Width="100"
                    Background="#8c6aff" Foreground="White" BorderThickness="0" CornerRadius="5" Padding="5,2"/>
		</StackPanel>

	</Grid>
</UserControl>