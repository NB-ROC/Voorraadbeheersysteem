<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:login="clr-namespace:Frontend.ViewModels.Login"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Frontend.Views.Login.LoginPageView"
             x:DataType="{x:Type login:LoginPageViewModel}">
    <Grid Background="White">

        <Border Width="440"
                Padding="40"
                Background="White"
                CornerRadius="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 8 30 #33000000">

            <StackPanel Spacing="28">

                <!-- Title -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Log in"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#2A2A2A" />
                    <TextBlock Text="om verder te gaan"
                               FontSize="18"
                               Foreground="#7A7A7A" />
                </StackPanel>

                <!-- Name -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Naam"

                               Foreground="#2A2A2A"
                               FontSize="15" />
                    <TextBox Text="{Binding Name}"
                             IsReadOnly="True"
                             BorderBrush="#5A1E81"
                             BorderThickness="2"
                             CornerRadius="10"
                             Padding="12"
                             FontSize="15" />
                </StackPanel>

                <!-- Password -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Wachtwoord"
                               Foreground="#2A2A2A"
                               FontSize="15" />
                    <TextBox Text="{Binding Password}"
                             PasswordChar="●"
                             Watermark="Vul hier je wachtwoord in"
                             BorderBrush="#5A1E81"
                             BorderThickness="2"
                             CornerRadius="10"
                             Padding="12"
                             FontSize="15" />
                </StackPanel>

                <!-- Continue Button -->
                <Button Content="Inloggen"
                        Command="{Binding LoginCommand}"
                        Background="#0077C8"
                        Foreground="White"
                        CornerRadius="12"
                        Padding="16"
                        FontSize="18"
                        HorizontalAlignment="Stretch" />

            </StackPanel>
        </Border>

    </Grid>
</UserControl>