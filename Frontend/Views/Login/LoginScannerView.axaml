<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:login="clr-namespace:Frontend.ViewModels.Login"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Frontend.Views.Login.LoginScannerView"
             x:DataType="login:LoginScannerViewModel">

    <Grid RowDefinitions="100,*,100">
        <ContentControl Content="{Binding Header}" />

        <TextBlock Grid.Row="1" Foreground="{StaticResource Purple}" Text="Scan u uitlenerspas om in te loggen" HorizontalAlignment="Center"
                   VerticalAlignment="Center" FontSize="60" />
    </Grid>
</UserControl>