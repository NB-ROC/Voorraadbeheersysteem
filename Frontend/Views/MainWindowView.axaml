<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Frontend.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Frontend.Views.MainWindowView"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="productoverzicht">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>
  <Grid RowDefinitions="60,*,60">

        <!-- HEADER -->
        <Border Background="#111827">
            <Grid ColumnDefinitions="*,Auto"
                  VerticalAlignment="Center">

                <!-- Titel -->
                <TextBlock Text="Header"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="20,0"/>

                <!-- Login knop -->
                <Button Grid.Column="1"
                        Content="Inloggen"
                        Margin="0,0,20,0"
                        Height="36"
                        MinWidth="110"
                        Background="#4F46E5"
                        Foreground="White"/>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="1" Background="#F6F7FB" RowDefinitions="Auto,Auto,*">

            <!-- Titel -->
            <StackPanel Grid.Row="0" Margin="20,20,20,12" Spacing="4">
                <TextBlock Text="Producten Overzicht"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1F2937" />
                <TextBlock Text="Bekijk en beheer alle beschikbare producten"
                           FontSize="13"
                           Foreground="#6B7280" />
            </StackPanel>

            <!-- Toolbar -->
            <Border Grid.Row="1"
                    Margin="20,0,20,16"
                    Background="White"
                    CornerRadius="12"
                    Padding="14"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">

                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">

                    <!-- Zoekbalk (dummy) -->
                    <Border Grid.Column="0"
                            Background="#F9FAFB"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8">
                        <TextBlock Text="🔍 Zoek producten..." Foreground="#9CA3AF"/>
                    </Border>

                    <Button Grid.Column="1"
                            Content="Filters"
                            Height="38"
                            MinWidth="100"/>

                    <Button Grid.Column="2"
                            Content="Product toevoegen"
                            Height="38"
                            MinWidth="150"
                            Background="#4F46E5"
                            Foreground="White"/>
                </Grid>
            </Border>

            <!-- LIJST -->
            <ScrollViewer Grid.Row="2" Margin="20">
                <StackPanel Spacing="12">

                    <!-- ITEM 1 -->
                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">

                        <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="14">

                            <!-- Image -->
                            <Border Width="72" Height="72" Background="#F3F4F6"
                                    CornerRadius="10">
                                <TextBlock Text="📦"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Categorie 1" FontSize="12" Foreground="#9CA3AF"/>
                                <TextBlock Text="Test Product" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Dit is een beschrijving van het product."
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Buttons -->
                            <StackPanel Grid.Column="2" Spacing="8">
                                <Button Content="Toevoegen aan mandje" Background="Orange" Foreground="White"/>
                                <Button Content="Verwijder uit mandje" Background="Red" Foreground="White"/>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!-- ITEM 2 -->
                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">

                        <TextBlock Text="Nog een test product..." />

                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#111827">
            <TextBlock Text="Footer"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="20,0"/>
        </Border>

    </Grid>
</Window>