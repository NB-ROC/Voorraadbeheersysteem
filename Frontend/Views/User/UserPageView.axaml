<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:user="clr-namespace:Frontend.ViewModels.User"
             x:Class="Frontend.Views.User.UserPageView"
             x:DataType="user:UserPageViewModel">

    <Grid RowDefinitions="100,*,100">

        <ContentControl Content="{Binding Header}" />

        <Grid Grid.Row="1" Background="{StaticResource DarkerWhite}" RowDefinitions="Auto,Auto,*">

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="20,20,20,12" Spacing="4">
                <TextBlock Text="Gebruiker Overzicht"
                           FontSize="28"
                           FontWeight="Bold"/>
                <TextBlock Text="Bekijk en beheer alle gebruikers"
                           FontSize="13"
                           Foreground="{StaticResource Gray}" />
            </StackPanel>

            <!-- Toolbar -->
            <Border Grid.Row="1"
                    Margin="20,0,20,16"
                    Background="{StaticResource DarkerWhite}"
                    CornerRadius="12"
                    Padding="14"
                    BorderBrush="{StaticResource Gray}"
                    BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto,Auto, Auto"
                      ColumnSpacing="10">

                    <!-- Zoekbalk -->
                    <Border Grid.Column="0"
                            Background="{StaticResource DarkerWhite}"
                            BorderBrush="{StaticResource Gray}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            VerticalAlignment="Center">
                        <TextBlock Text="🔍 Zoek gebruikers..."
                                   FontSize="13" />
                    </Border>

                    <!-- Filter knop -->
                    <Button Grid.Column="1"
                            Content="Filters"
                            Height="38"
                            MinWidth="100"
                            Background="{StaticResource DarkerWhite}"
                            BorderBrush="{StaticResource Gray}"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />

                    <!-- Product toevoegen -->
                    <Button Grid.Column="2"
                            Content="Gebruiker toevoegen"
                            Height="38"
                            MinWidth="150"
                            Background="{StaticResource Purple}"
                            Foreground="{StaticResource White}"
                            BorderThickness="0"
                            CornerRadius="8"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Command="{Binding NavigateUserForm}" />
                </Grid>
            </Border>

            <!-- Items lijst -->
            <ScrollViewer Grid.Row="2" Margin="20,0,20,20">
                <ListBox ItemsSource="{Binding Users}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type user:UserViewModel}">
                            <StackPanel Spacing="12">

                                <Border Background="{StaticResource White}"
                                        BorderBrush="{StaticResource DarkerWhite}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14">
                                    <Grid ColumnDefinitions="80,*,Auto"
                                          ColumnSpacing="14">

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Spacing="4">
                                            <TextBlock Text="{Binding Number}"
                                                       Foreground="{StaticResource Gray}"
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource Gray}"
                                                       FontSize="16" />
                                            <TextBlock Text="{Binding Email}"
                                                       Foreground="{StaticResource Gray}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Actie -->
                                        <DockPanel HorizontalSpacing="12" Grid.Column="2"
                                                   VerticalAlignment="Center">
                                            <Button Content="Bewerk"
                                                    Background="Orange"
                                                    Foreground="{StaticResource White}"
                                                    Padding="12 8"
                                                    CornerRadius="8"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Command="{Binding EditCommand}" />
                                            <Button Content="Verwijder"
                                                    Background="Red"
                                                    Foreground="{StaticResource White}"
                                                    Padding="12 8"
                                                    CornerRadius="8"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Command="{Binding DeleteCommand}" />
                                        </DockPanel>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

        </Grid>

        <ContentControl Grid.Row="2" Content="{Binding Footer}" />


    </Grid>


</UserControl>