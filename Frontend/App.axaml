<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Frontend.App"
             xmlns:local="using:Frontend"
             RequestedThemeVariant="Light">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <Styles>
            <!-- Hier kun je globale styles zetten -->
            <Style Selector="TextBox.NoFocusBackground">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
        </Styles>
    </Application.Styles>
    
    <Application.Resources>
        <SolidColorBrush x:Key="Purple">#6E6EB4</SolidColorBrush>
        <SolidColorBrush x:Key="White">#FAFAFA</SolidColorBrush>
        <SolidColorBrush x:Key="DarkerWhite">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Gray">#6B7280</SolidColorBrush>
        <BoxShadows x:Key="Shadow">0 4 10 0 #40000000</BoxShadows>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

</Application>